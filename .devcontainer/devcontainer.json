{
  "name": "ghtun-warzone",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    }
  },
  "postStartCommand": "bash /usr/local/bin/g-tun.sh --silent-start",
  "postAttachCommand": "bash /usr/local/bin/g-tun.sh",
  "portsAttributes": {
    "443": {
      "label": "xray-ws",
      "protocol": "https",
      "onAutoForward": "silent",
      "visibility": "public"
    }
  },
  "forwardPorts": [443],
  "hostRequirements": {
    "cpus": 2
  }
}
